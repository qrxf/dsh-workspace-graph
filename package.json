{
  "name": "dsh-workspace-graph",
  "version": "0.1.1",
  "description": "Draggable workspace and session graph for DeepSeek Harness / 可拖拽的工作区图谱",
  "type": "module",
  "license": "MIT",
  "main": "dist/host.js",
  "exports": {
    ".": "./dist/host.js",
    "./client": "./dist/client.js"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs/screenshots"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "demo": "vite --host 127.0.0.1",
    "test:browser": "node tests/browser.mjs",
    "test:flex": "node tests/flex-drag-browser.mjs",
    "prepack": "npm run build",
    "test:native": "node tests/native.mjs",
    "test:performance": "node tests/performance-browser.mjs",
    "test:catalog": "node tests/catalog-performance.mjs",
    "test:interactions": "node scripts/test-interactions.mjs",
    "format": "prettier --write src tests scripts package.json tsconfig.json"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qrxf/dsh-workspace-graph.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "workspace",
    "graph"
  ],
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-api-remote-access": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@xyflow/react": "12.12.0",
    "esbuild": "0.28.2",
    "playwright": "^1.56.0",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  }
}
